# Copy this file to `.env` and fill in the values printed by infra/provision.sh.
# NEVER commit a real .env file or any API keys. Authentication uses Entra ID
# (DefaultAzureCredential) — no keys are required or stored here.

# Foundry project endpoint, e.g.
# https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name created by the Bicep template.
MODEL_DEPLOYMENT_NAME=gpt-5.4

# Azure region (all resources live here).
AZURE_REGION=eastus2

# Name of the prompt agent created/invoked by run_agent.py.
AGENT_NAME=logs-analysis-agent

# Paths to the authored SKILL.md files that publish_skill.py uploads to Foundry.
SOURCE_SKILL_PATHS=source/skills/web-logs-analysis/SKILL.md,source/skills/k8s-logs-analysis/SKILL.md

# Backward-compatible source skill paths for publishing.
SKILL_PATHS=source/skills/web-logs-analysis/SKILL.md,source/skills/k8s-logs-analysis/SKILL.md
SOURCE_SKILL_PATH=source/skills/web-logs-analysis/SKILL.md
SKILL_PATH=source/skills/web-logs-analysis/SKILL.md

# Foundry skill names used by the Skills API direct-download flow.
FOUNDRY_SKILL_NAMES=web-logs-analysis,k8s-logs-analysis

# Optional Foundry toolbox name for the separate toolbox/MCP flow.
FOUNDRY_TOOLBOX_NAME=logs-analysis-toolbox

# Backward-compatible single-skill name.
FOUNDRY_SKILL_NAME=web-logs-analysis

# Optional: only needed for some tooling / role assignments.
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=rg-foundry-logs-analysis
